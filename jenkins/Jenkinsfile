```groovy
pipeline {
    agent any

    environment {
        AWS_REGION   = 'us-west-1'
        ECR_REGISTRY = '026869448226.dkr.ecr.us-west-1.amazonaws.com'
        DEPLOY_DIR   = '/home/ubuntu/task-manager'
        COMPOSE_FILE = 'app/docker-compose.prod.yml'
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Image version sent by GitHub Actions'
        )
    }

    stages {
        stage('Validate version') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error('IMAGE_TAG is required')
                    }

                    if (!(params.IMAGE_TAG ==~ /[a-zA-Z0-9_.-]+/)) {
                        error('IMAGE_TAG contains invalid characters')
                    }
                }

                echo "New version: ${params.IMAGE_TAG}"
            }
        }

        stage('Deploy from ECR') {
            steps {
                sh '''
                    set -eu

                    export IMAGE_TAG="${IMAGE_TAG}"

                    # Use the production Compose file from the Jenkins checkout
                    COMPOSE_PATH="$WORKSPACE/$COMPOSE_FILE"
                    ENV_FILE="$DEPLOY_DIR/.env"
                    TAG_FILE="$DEPLOY_DIR/.current_image_tag"

                    # Verify required files exist
                    test -f "$COMPOSE_PATH" || {
                        echo "ERROR: Compose file not found: $COMPOSE_PATH"
                        exit 1
                    }

                    test -f "$ENV_FILE" || {
                        echo "ERROR: Environment file not found: $ENV_FILE"
                        exit 1
                    }

                    # Ensure Jenkins can access deployment state
                    test -w "$DEPLOY_DIR" || {
                        echo "ERROR: Jenkins cannot write to $DEPLOY_DIR"
                        exit 1
                    }

                    # Authenticate to ECR using the EC2 IAM role
                    aws ecr get-login-password --region "$AWS_REGION" \
                      | docker login \
                          --username AWS \
                          --password-stdin "$ECR_REGISTRY"

                    # Remember the currently deployed version
                    if [ -f "$TAG_FILE" ]; then
                        PREVIOUS_TAG=$(cat "$TAG_FILE")
                    else
                        PREVIOUS_TAG=""
                    fi

                    echo "Previous version: ${PREVIOUS_TAG:-none}"
                    echo "Deploying version: $IMAGE_TAG"

                    # Pull the exact version from ECR
                    docker compose \
                      --env-file "$ENV_FILE" \
                      -f "$COMPOSE_PATH" \
                      pull

                    # Start the application, including MySQL if required
                    docker compose \
                      --env-file "$ENV_FILE" \
                      -f "$COMPOSE_PATH" \
                      up -d

                    # Verify backend health
                    if curl --fail --silent --show-error \
                      --retry 12 \
                      --retry-connrefused \
                      --retry-delay 5 \
                      http://localhost:8081/api/health; then

                        printf '%s\\n' "$IMAGE_TAG" > "$TAG_FILE"
                        echo "Deployment successful: $IMAGE_TAG"

                    else
                        echo "ERROR: Health check failed."

                        # Restore the previous version if available
                        if [ -n "$PREVIOUS_TAG" ]; then
                            echo "Rolling back to $PREVIOUS_TAG"

                            export IMAGE_TAG="$PREVIOUS_TAG"

                            docker compose \
                              --env-file "$ENV_FILE" \
                              -f "$COMPOSE_PATH" \
                              pull

                            docker compose \
                              --env-file "$ENV_FILE" \
                              -f "$COMPOSE_PATH" \
                              up -d

                            echo "Rollback attempted."
                        else
                            echo "No previous version is recorded; rollback unavailable."
                        fi

                        exit 1
                    fi
                '''
            }
        }
    }

    post {
        success {
            echo 'CI/CD deployment completed successfully.'
        }

        failure {
            echo 'Deployment failed. Check the console output for the first ERROR.'
        }

        always {
            echo 'Jenkins pipeline finished.'
        }
    }
}
```