
pipeline {
    agent any

    environment {
        AWS_REGION   = 'us-west-1'
        ECR_REGISTRY = '026869448226.dkr.ecr.us-west-1.amazonaws.com'
        DEPLOY_DIR   = '/home/ubuntu/task-manager'
        COMPOSE_FILE = 'app/docker-compose.prod.yml'
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Image version sent by GitHub Actions'
        )
    }

    stages {
        stage('Validate version') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error('IMAGE_TAG is required')
                    }
                }
                echo "Deploying version: ${params.IMAGE_TAG}"
            }
        }

        stage('Deploy from ECR') {
            steps {
                sh '''
                    set -eu

                    export IMAGE_TAG="$IMAGE_TAG"

                    # Login to ECR using the EC2 IAM role
                    aws ecr get-login-password --region "$AWS_REGION" |
                        docker login --username AWS --password-stdin "$ECR_REGISTRY"

                    # Save previous version for rollback
                    PREVIOUS_TAG=$(cat "$DEPLOY_DIR/.current_image_tag" 2>/dev/null || true)

                    echo "Previous version: ${PREVIOUS_TAG:-none}"
                    echo "New version: $IMAGE_TAG"

                    deploy() {
                        export IMAGE_TAG="$1"

                        docker compose \
                            --env-file "$DEPLOY_DIR/.env" \
                            -f "$COMPOSE_FILE" pull frontend backend

                        docker compose \
                            --env-file "$DEPLOY_DIR/.env" \
                            -f "$COMPOSE_FILE" up -d
                    }

                    # Deploy the new version and verify backend health
                    if deploy "$IMAGE_TAG" &&
                       curl --fail --retry 10 --retry-all-errors \
                           --retry-delay 5 \
                           http://localhost:8081/api/health; then

                        echo "$IMAGE_TAG" > "$DEPLOY_DIR/.current_image_tag"
                        echo "Deployment successful!"

                    else
                        echo "Deployment failed. Starting rollback..."

                        if [ -n "$PREVIOUS_TAG" ]; then
                            deploy "$PREVIOUS_TAG"

                            if curl --fail --retry 10 --retry-all-errors \
                                --retry-delay 5 \
                                http://localhost:8081/api/health; then
                                echo "Rollback successful."
                            else
                                echo "Rollback health check failed."
                            fi
                        else
                            echo "No previous version available for rollback."
                        fi

                        exit 1
                    fi
                '''
            }
        }
    }
}
